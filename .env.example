# --- DATABASE SETTINGS ---
DB_ROOT_PASSWORD=rootpassword
DB_NAME=curahub
DB_USER=curahub_user
DB_PASSWORD=secure_password_here

# The external port (for tools like TablePlus), default is 3306
DB_EXTERNAL_PORT=3306

# IMPORTANT: This URL is used by the App inside Docker. 
# Use "db:3306" here, NOT "localhost" or the external port.
# FORMAT: mysql://${DB_USER}:${DB_PASSWORD}@db:3306/${DB_NAME}
DATABASE_URL=mysql://curahub_user:secure_password_here@db:3306/curahub


# --- BACKEND SETTINGS ---
JWT_SECRET=generate_a_very_long_random_string_here
APP_PORT=3000
APP_EXTERNAL_PORT=3000


# --- ENVIRONMENT ---
NODE_ENV=production
